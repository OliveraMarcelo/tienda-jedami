# ─────────────────────────────────────────────────────────────────────────────
# .env.prod.example — Plantilla de variables de entorno para producción
#
# Instrucciones:
#   1. Copiar este archivo: cp .env.prod.example .env.prod
#   2. Completar TODOS los valores marcados con TODO
#   3. NUNCA commitear .env.prod al repositorio (está en .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# ── Docker Hub (requerido para docker compose pull en producción) ─────────────
DOCKERHUB_USERNAME=TODO_tu_usuario_docker_hub

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=jedami
POSTGRES_PASSWORD=TODO_cambia_esta_password_segura
POSTGRES_DB=jedami_prod

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=TODO_cambia_esta_password_segura

# ── Backend (jedami-bff) ─────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# JWT — generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=TODO_secret_aleatorio_de_64_bytes_minimo
# Sesión corta (se renueva sola con el refresh token): los cambios de rol aplican en minutos
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — dominio(s) del frontend separados por coma
# Ejemplos: https://jedami.com  o  https://jedami.com,https://www.jedami.com
CORS_ORIGIN=http://TU_IP_O_DOMINIO
FRONTEND_URL=http://TU_IP_O_DOMINIO

# Mercado Pago
MP_PUBLIC_KEY=TODO_tu_mp_public_key_produccion
MP_ACCESS_TOKEN=TODO_tu_mp_access_token_produccion
MP_WEBHOOK_SECRET=TODO_tu_mp_webhook_secret
MP_WEBHOOK_URL=https://TU_DOMINIO/api/v1/payments/webhook

# Emails (opcional: sin SMTP_HOST no se envía nada y todo sigue funcionando).
# Se usan para: pago confirmado, código para verificar la cuenta y "Olvidé mi contraseña".
# Con SMTP configurado, las cuentas NUEVAS deben confirmar su email con un código.
# Ejemplo con Gmail (contraseña de aplicación: myaccount.google.com → Seguridad →
# Verificación en 2 pasos → Contraseñas de aplicaciones):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=tucuenta@gmail.com
#   SMTP_PASS=abcdefghijklmnop (las 16 letras, sin espacios)  MAIL_FROM="Jedami <tucuenta@gmail.com>"
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Jedami <ventas@tudominio.com>"

# Ingresar con Google (opcional: sin esto el botón no aparece). Ver docs/google-login.md
GOOGLE_CLIENT_ID=

# IA para el admin (opcional: sin AI_BASE_URL el botón "✨ Generar con IA" no aparece). Ver docs/ia.md
# Cualquier API compatible con OpenAI:
#   Ollama de tu compu por Tailscale: AI_BASE_URL=http://100.x.y.z:11434/v1   AI_MODEL=jedami-descripciones
#   OpenAI:                           AI_BASE_URL=https://api.openai.com/v1   AI_MODEL=<modelo>  AI_API_KEY=sk-...  AI_ALLOW_EXTERNAL_PROVIDER=true
AI_BASE_URL=
AI_MODEL=jedami-descripciones
AI_API_KEY=
# Seguridad: solo se aceptan modelos locales o en red privada (localhost, LAN, Tailscale 100.x).
# Para un proveedor externo (OpenAI, Gemini…) poner true; además tiene que ser https.
AI_ALLOW_EXTERNAL_PROVIDER=false
# Un modelo local sin placa de video puede tardar: 90 s de espera máxima
AI_TIMEOUT_MS=90000
# Razonamiento del modelo (none, low, medium, high). Vacío = none con modelo local, sin enviar con uno externo
AI_REASONING_EFFORT=
# Generaciones por IP cada 15 minutos
AI_RATE_LIMIT_MAX=60

# Rate limiting (valores recomendados para producción)
RATE_LIMIT_WINDOW_MS=900000
# General por IP (el pago con QR consulta el estado cada 6 s, por eso es generoso)
RATE_LIMIT_MAX=1000
# Registro, recuperar contraseña, códigos de verificación y login con Google
AUTH_RATE_LIMIT_MAX=20
# Intentos de login FALLIDOS por IP en la ventana
LOGIN_RATE_LIMIT_MAX=10

# Documentación de la API en /api/docs (en producción está apagada salvo que pongas true)
ENABLE_API_DOCS=false

# Caché Redis TTL en segundos
CACHE_TTL=300

# Versión desplegada. La escribe el deploy automáticamente (junto con DOCKERHUB_USERNAME):
# un "docker compose ... --env-file .env.prod up -d" manual levanta esta versión.
APP_VERSION=
