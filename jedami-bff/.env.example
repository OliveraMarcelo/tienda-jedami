PORT=3000
DATABASE_URL=postgresql://jedami:jedami@localhost:5432/jedami_dev
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
NODE_ENV=development
LOG_LEVEL=info

FRONTEND_URL=http://localhost:5173

# Mercado Pago
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_WEBHOOK_URL=https://tu-ngrok.loca.lt/api/v1/payments/webhook

# Redis (opcional — si no está configurado el caché está desactivado)
REDIS_URL=redis://localhost:6379
CACHE_TTL=300

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

# IA (opcional): Ollama local con el modelo creado desde ai/Modelfile.jedami-descripciones (ver docs/ia.md)
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=jedami-descripciones
AI_API_KEY=
AI_TIMEOUT_MS=90000
# Razonamiento del modelo (none, low, medium, high). Vacío = none con modelo local, sin enviar con uno externo
AI_REASONING_EFFORT=
